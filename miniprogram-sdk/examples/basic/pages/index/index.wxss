/* pages/index/index.wxss */
.container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #000;
}

/* 数字人画布区域 */
.avatar-canvas {
  width: 100%;
  background-color: #111;
}

/* 画布大小滑块 */
.canvas-size-section {
  padding: 10rpx 20rpx;
  background-color: #1a1a1a;
  border-top: 1rpx solid #333;
}

/* 收起/展开按钮 */
.toggle-bar {
  padding: 16rpx 0;
  background-color: #222;
  text-align: center;
  border-top: 1rpx solid #333;
  border-bottom: 1rpx solid #333;
}

.toggle-text {
  color: #4CAF50;
  font-size: 26rpx;
}

/* 控制面板 */
.control-panel {
  flex: 1;
  padding: 20rpx;
  background-color: #1a1a1a;
  overflow-y: auto;
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.status-text, .session-text {
  color: #888;
  font-size: 24rpx;
}

/* 按钮行 */
.btn-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.btn {
  flex: 1;
  margin: 0 10rpx;
  padding: 20rpx 0;
  background-color: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn[disabled] {
  background-color: #333;
  color: #666;
}

.btn-small {
  font-size: 24rpx;
  padding: 15rpx 0;
}

.btn-danger {
  background-color: #f44336;
}

/* 输入区域 */
.input-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.text-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #333;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.speak-btn {
  margin-left: 20rpx;
  width: 180rpx;
}

/* 音量控制 */
.volume-section {
  margin-bottom: 20rpx;
}

.label {
  color: #888;
  font-size: 24rpx;
  display: block;
  margin-bottom: 10rpx;
}

/* WebSocket 监控面板 */
.ws-section {
  margin-top: 20rpx;
  border-top: 1rpx solid #333;
  padding-top: 16rpx;
}

.ws-header {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.ws-title {
  color: #ccc;
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.ws-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  background-color: #666;
}

.ws-indicator.ws-connected { background-color: #4CAF50; }
.ws-indicator.ws-connecting { background-color: #FFC107; }
.ws-indicator.ws-disconnected { background-color: #f44336; }

.ws-status-text {
  color: #888;
  font-size: 22rpx;
  flex: 1;
}

.ws-status-text.ws-connected { color: #4CAF50; }
.ws-status-text.ws-disconnected { color: #f44336; }

.toggle-arrow {
  color: #666;
  font-size: 22rpx;
}

/* 连接统计 */
.ws-stats {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0;
}

.ws-stat {
  flex: 1;
  background-color: #222;
  border-radius: 8rpx;
  padding: 12rpx;
  text-align: center;
}

.ws-stat-label {
  color: #666;
  font-size: 20rpx;
  display: block;
}

.ws-stat-value {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: block;
  margin-top: 4rpx;
}

.ws-stat-value.ws-connected { color: #4CAF50; }
.ws-stat-value.ws-disconnected { color: #f44336; }
.ws-stat-value.ws-connecting { color: #FFC107; }

/* 日志列表 */
.ws-log-list {
  height: 300rpx;
  background-color: #111;
  border-radius: 8rpx;
  padding: 12rpx;
  margin-bottom: 12rpx;
}

.ws-log {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 6rpx 0;
  border-bottom: 1rpx solid #1a1a1a;
}

.ws-log-time {
  color: #555;
  font-size: 20rpx;
  flex-shrink: 0;
  width: 130rpx;
  font-family: monospace;
}

.ws-log-tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
  color: #fff;
  background-color: #555;
}

.ws-tag-face { background-color: #6366f1; }
.ws-tag-body { background-color: #8b5cf6; }
.ws-tag-audio { background-color: #ec4899; }
.ws-tag-event { background-color: #f59e0b; }
.ws-tag-conn { background-color: #10b981; }
.ws-tag-err { background-color: #ef4444; }
.ws-tag-send { background-color: #3b82f6; }

.ws-log-msg {
  color: #aaa;
  font-size: 20rpx;
  flex: 1;
  word-break: break-all;
}

.ws-actions {
  display: flex;
  justify-content: flex-end;
}
