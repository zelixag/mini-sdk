/* pages/index/index.wxss */
.container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #000;
}

/* 数字人画布区域 */
.avatar-canvas {
  width: 100%;
  height: 60vh;
  background-color: #111;
}

/* 控制面板 */
.control-panel {
  flex: 1;
  padding: 20rpx;
  background-color: #1a1a1a;
  border-top: 1rpx solid #333;
}

/* 状态栏 */
.status-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.status-text, .session-text {
  color: #888;
  font-size: 24rpx;
}

/* 按钮行 */
.btn-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}

.btn {
  flex: 1;
  margin: 0 10rpx;
  padding: 20rpx 0;
  background-color: #4CAF50;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn[disabled] {
  background-color: #333;
  color: #666;
}

.btn-small {
  font-size: 24rpx;
  padding: 15rpx 0;
}

.btn-danger {
  background-color: #f44336;
}

/* 输入区域 */
.input-section {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.text-input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #333;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.speak-btn {
  margin-left: 20rpx;
  width: 180rpx;
}

/* 音量控制 */
.volume-section {
  margin-bottom: 20rpx;
}

.label {
  color: #888;
  font-size: 24rpx;
  display: block;
  margin-bottom: 10rpx;
}
