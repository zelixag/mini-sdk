/* 数字人示例 — 控制台风格：深色基底 + 琥珀强调，专业工具感 */

page {
  --bg-base: #0a0a0c;
  --bg-panel: #12121a;
  --bg-panel-elevated: #18181f;
  --border-subtle: rgba(255, 255, 255, 0.06);
  --border-muted: rgba(255, 255, 255, 0.12);
  --text-primary: #ffffff;
  --text-secondary: #a8b0bc;
  --text-muted: #6a7280;
  --accent: #e4a853;
  --accent-dim: rgba(228, 168, 83, 0.25);
  --cta: #00c853;
  --cta-dim: rgba(0, 200, 83, 0.2);
  --radius-sm: 10rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
}

.container {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  background: var(--bg-base);
}

.page-content {
  padding: 48rpx 32rpx 220rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.page-hero {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-title {
  color: var(--text-primary);
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.hero-sub {
  color: var(--text-secondary);
  font-size: 24rpx;
}

.page-cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.page-card {
  background: var(--bg-panel);
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-title {
  color: var(--text-muted);
  font-size: 22rpx;
}

.card-value {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.page-feed {
  background: var(--bg-panel-elevated);
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.feed-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.feed-title {
  color: var(--text-primary);
}

.canvas-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.canvas-widget {
  position: fixed;
  right: 24rpx;
  bottom: calc(140rpx + constant(safe-area-inset-bottom));
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  width: 320rpx;
  height: 420rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(228, 168, 83, 0.35);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.4);
  overflow: hidden;
  z-index: 900;
}

.canvas-widget-expanded {
  width: 86vw;
  height: 70vh;
  right: 7vw;
  bottom: 16vh;
  border-radius: 28rpx;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.avatar-canvas {
  width: 100%;
  height: 100%;
  background: var(--bg-base);
  position: relative;
  z-index: 1;
}

.avatar-canvas-half {
  width: 50% !important;
  height: 50% !important;
}

.subtitle-overlay {
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  max-width: 80%;
  padding: 12rpx 20rpx;
  background: rgba(0, 0, 0, 0.75);
  border-radius: 16rpx;
  z-index: 2;
}

.subtitle-text {
  color: #fff;
  font-size: 26rpx;
  text-align: center;
  word-break: break-all;
}

.widget-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 12rpx 16rpx;
  background: rgba(10, 10, 12, 0.7);
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 3;
}

.widget-title {
  display: flex;
  flex-direction: column;
  color: var(--text-primary);
  font-size: 22rpx;
}

.widget-status {
  color: var(--accent);
  font-size: 20rpx;
}

.widget-actions {
  display: flex;
  gap: 8rpx;
}

/* ----- 收起时的操作入口 ----- */
.controls-trigger {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  z-index: 1000;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  pointer-events: auto;
}

.btn-trigger {
  width: 140rpx;
  height: 64rpx;
  line-height: 64rpx;
  background: var(--bg-panel);
  color: var(--accent);
  border-radius: var(--radius-md);
  font-size: 26rpx;
  font-weight: 500;
  border: 1rpx solid var(--border-muted);
  letter-spacing: 0.5rpx;
}

.btn-trigger::after {
  border: none;
}

/* ----- 展开时的操作盒 ----- */
.controls-box {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  z-index: 1000;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--bg-panel);
  border: 1rpx solid var(--border-subtle);
  border-top: 1rpx solid var(--border-muted);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  pointer-events: auto;
}

.controls-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--border-subtle);
}

.controls-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.btn-mini {
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  background: var(--accent-dim);
  color: var(--accent);
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  border: 1rpx solid rgba(228, 168, 83, 0.35);
}

.btn-mini::after {
  border: none;
}

.controls-body {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx 20rpx;
}

.btn {
  min-width: 72rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  background: var(--bg-panel-elevated);
  color: var(--text-secondary);
  border-radius: var(--radius-sm);
  font-size: 25rpx;
  border: 1rpx solid var(--border-subtle);
  box-sizing: border-box;
}

.btn.btn-speak {
  background: var(--cta);
  color: #fff;
  min-width: 88rpx;
  font-weight: 500;
  border-color: transparent;
}

.btn:active {
  opacity: 0.9;
}

.btn::after {
  border: none;
}

/* ----- 加载状态 ----- */
.status {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1000;
  color: var(--text-secondary);
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

/* ----- 调参面板 ----- */
.align-panel {
  position: fixed;
  top: auto;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(100rpx + constant(safe-area-inset-bottom));
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  max-height: 58vh;
  z-index: 999;
  display: flex;
  flex-direction: column;
  background: var(--bg-panel);
  border: 1rpx solid var(--border-subtle);
  border-top: 1rpx solid var(--border-muted);
  border-radius: var(--radius-lg);
  padding: 24rpx 24rpx 28rpx;
  overflow-y: auto;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-subtle);
}

.panel-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.mini-btn-ghost {
  background: var(--accent-dim);
  color: var(--accent);
  border: 1rpx solid rgba(228, 168, 83, 0.35);
}

.mini-btn-ghost::after {
  border: none;
}

.ws-panel {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(100rpx + constant(safe-area-inset-bottom));
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  max-height: 62vh;
  z-index: 998;
  display: flex;
  flex-direction: column;
  background: var(--bg-panel);
  border: 1rpx solid var(--border-subtle);
  border-top: 1rpx solid var(--border-muted);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  overflow: hidden;
}

.ws-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.ws-stat {
  background: var(--bg-panel-elevated);
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 12rpx;
}

.ws-label {
  color: var(--text-muted);
  font-size: 22rpx;
}

.ws-value {
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 6rpx;
  display: block;
}

.ws-controls,
.ws-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.ws-switch {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ws-log-list {
  flex: 1;
  background: var(--bg-panel-elevated);
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 12rpx;
}

.ws-log {
  display: grid;
  grid-template-columns: 140rpx 120rpx 160rpx 1fr;
  gap: 8rpx;
  padding: 6rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.ws-log:last-child {
  border-bottom: none;
}

.ws-time,
.ws-socket,
.ws-payload {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.ws-type {
  text-align: center;
  border-radius: 999rpx;
  padding: 2rpx 8rpx;
  font-size: 22rpx;
  color: #fff;
  background: #3b82f6;
}

.ws-type-open {
  background: #10b981;
}

.ws-type-close {
  background: #6b7280;
}

.ws-type-error {
  background: #ef4444;
}

.ws-type-send {
  background: #6366f1;
}

.ws-type-message {
  background: #8b5cf6;
}

.ws-actions {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.event-panel {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(100rpx + constant(safe-area-inset-bottom));
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  max-height: 45vh;
  z-index: 997;
  display: flex;
  flex-direction: column;
  background: var(--bg-panel);
  border: 1rpx solid var(--border-subtle);
  border-top: 1rpx solid var(--border-muted);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  gap: 12rpx;
}

.event-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.event-label {
  color: var(--text-muted);
  font-size: 22rpx;
  width: 140rpx;
}

.event-value {
  color: var(--text-primary);
  font-size: 24rpx;
  flex: 1;
  word-break: break-all;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.label {
  color: var(--text-secondary);
  font-size: 24rpx;
}

.value {
  color: var(--text-primary);
  font-size: 24rpx;
  min-width: 96rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.hint {
  color: var(--text-muted);
  font-size: 22rpx;
  line-height: 1.4;
  margin-top: 4rpx;
}

.slider {
  margin: 4rpx 0 8rpx;
}

.panel-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.mini-btn {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-panel-elevated);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-subtle);
}

.mini-btn::after {
  border: none;
}

.import-title {
  color: var(--text-muted);
  font-size: 22rpx;
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}

.import-input {
  width: 100%;
  min-height: 120rpx;
  margin-top: 0;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-sm);
  background: var(--bg-base);
  color: var(--text-primary);
  font-size: 22rpx;
  line-height: 1.5;
}
