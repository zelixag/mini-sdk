<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 数字人画布 -->
  <canvas
    type="webgl2"
    id="avatar-canvas"
    class="avatar-canvas"
    style="height: {{canvasHeight}}vh;"
    bindtouchstart="handleTouchStart"
    bindtouchend="handleTouchEnd"
  ></canvas>

  <!-- 画布大小滑块 -->
  <view class="canvas-size-section">
    <text class="label">画布: {{canvasHeight}}%</text>
    <slider
      min="20"
      max="95"
      value="{{canvasHeight}}"
      bindchange="handleCanvasSizeChange"
      activeColor="#4CAF50"
      block-color="#fff"
      block-size="12"
    />
  </view>

  <!-- 收起/展开按钮 -->
  <view class="toggle-bar" bindtap="togglePanel">
    <text class="toggle-text">{{panelCollapsed ? '展开控制面板 ▲' : '收起控制面板 ▼'}}</text>
  </view>

  <!-- 控制面板（可收起） -->
  <view class="control-panel" wx:if="{{!panelCollapsed}}">
    <!-- 状态显示 -->
    <view class="status-bar">
      <text class="status-text">状态: {{status}}</text>
      <text class="session-text" wx:if="{{sessionId}}">会话: {{sessionId}}</text>
    </view>

    <!-- 基础控制 -->
    <view class="btn-row">
      <button class="btn" bindtap="handleInit" disabled="{{isInitialized}}">初始化</button>
      <button class="btn" bindtap="handleStart" disabled="{{!isInitialized || isPlaying}}">开始</button>
      <button class="btn" bindtap="handlePause" disabled="{{!isPlaying}}">暂停</button>
    </view>

    <!-- 文本输入 -->
    <view class="input-section">
      <input
        class="text-input"
        placeholder="输入要说的话..."
        value="{{inputText}}"
        bindinput="handleInput"
      />
      <button class="btn speak-btn" bindtap="handleSpeak" disabled="{{!isPlaying}}">发送</button>
    </view>

    <!-- 状态按钮 -->
    <view class="btn-row">
      <button class="btn btn-small" bindtap="handleIdle">空闲</button>
      <button class="btn btn-small" bindtap="handleListen">倾听</button>
      <button class="btn btn-small" bindtap="handleThink">思考</button>
    </view>

    <!-- 音量控制 -->
    <view class="volume-section">
      <text class="label">音量: {{volume}}</text>
      <slider
        min="0"
        max="100"
        value="{{volume * 100}}"
        bindchange="handleVolumeChange"
        activeColor="#4CAF50"
        block-color="#fff"
        block-size="12"
      />
    </view>

    <!-- 销毁按钮 -->
    <view class="btn-row">
      <button class="btn btn-danger" bindtap="handleStop" disabled="{{!isPlaying}}">停止</button>
      <button class="btn btn-danger" bindtap="handleDestroy">销毁</button>
    </view>

    <!-- WebSocket 监控面板 -->
    <view class="ws-section">
      <view class="ws-header" bindtap="toggleWsPanel">
        <text class="ws-title">WebSocket 监控</text>
        <text class="ws-indicator ws-{{wsStatus}}"></text>
        <text class="ws-status-text">{{wsStatusText}}</text>
        <text class="toggle-arrow">{{wsPanelOpen ? '▼' : '▶'}}</text>
      </view>

      <view wx:if="{{wsPanelOpen}}">
        <!-- 连接状态 -->
        <view class="ws-stats">
          <view class="ws-stat">
            <text class="ws-stat-label">状态</text>
            <text class="ws-stat-value ws-{{wsStatus}}">{{wsStatusText}}</text>
          </view>
          <view class="ws-stat">
            <text class="ws-stat-label">收到</text>
            <text class="ws-stat-value">{{wsCounters.message}}</text>
          </view>
          <view class="ws-stat">
            <text class="ws-stat-label">发送</text>
            <text class="ws-stat-value">{{wsCounters.send}}</text>
          </view>
          <view class="ws-stat">
            <text class="ws-stat-label">重连</text>
            <text class="ws-stat-value">{{wsCounters.reconnect}}</text>
          </view>
        </view>

        <!-- 数据筛选 -->
        <view class="ws-filters">
          <text class="ws-filter {{wsFilter === 'all' ? 'ws-filter-active' : ''}}" bindtap="setWsFilter" data-filter="all">全部</text>
          <text class="ws-filter {{wsFilter === 'speak' ? 'ws-filter-active' : ''}}" bindtap="setWsFilter" data-filter="speak">speak</text>
          <text class="ws-filter {{wsFilter === 'data' ? 'ws-filter-active' : ''}}" bindtap="setWsFilter" data-filter="data">face/body</text>
          <text class="ws-filter {{wsFilter === 'conn' ? 'ws-filter-active' : ''}}" bindtap="setWsFilter" data-filter="conn">连接</text>
          <text class="ws-filter {{wsFilter === 'diag' ? 'ws-filter-active' : ''}}" bindtap="setWsFilter" data-filter="diag">诊断</text>
        </view>

        <!-- 数据流日志（按筛选显示） -->
        <scroll-view class="ws-log-list" scroll-y scroll-into-view="{{wsScrollAnchor}}" enhanced show-scrollbar="{{false}}">
          <block wx:for="{{wsLogs}}" wx:key="id">
            <view class="ws-log" wx:if="{{item.show}}" id="ws-{{item.id}}">
              <text class="ws-log-time">{{item.time}}</text>
              <text class="ws-log-tag ws-tag-{{item.tag}}">{{item.tag}}</text>
              <text class="ws-log-msg">{{item.msg}}</text>
            </view>
          </block>
          <view id="ws-bottom"></view>
        </scroll-view>

        <view class="ws-actions">
          <button class="btn btn-small" bindtap="clearWsLogs">清空</button>
        </view>
      </view>
    </view>
  </view>
</view>
