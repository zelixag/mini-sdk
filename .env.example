# 阿里云 OSS 上传配置（upload-sdk.js）
# 复制为 .env 并填写真实值，勿提交 .env

# 第一个 OSS 账号（xmovAvatar / LiteAvatar）
ALIYUN_OSS1_REGION=oss-cn-shanghai
ALIYUN_OSS1_ACCESS_KEY_ID=
ALIYUN_OSS1_ACCESS_KEY_SECRET=
ALIYUN_OSS1_BUCKET=public-xingyun3d

# 第二个 OSS 账号（index.umd）
ALIYUN_OSS2_REGION=oss-cn-hangzhou
